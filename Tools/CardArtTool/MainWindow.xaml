<Window x:Class="CardArtTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:CardArtTool.Converters"
        Title="猫鼠尖塔 · 卡图替换工具"
        Width="1500" Height="920"
        MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <conv:InvertBoolConverter x:Key="InvertBool" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Padding" Value="22" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style x:Key="PreviewTile" TargetType="Border">
            <Setter Property="Background" Value="#FFF9F7F2" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="14" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 路径与筛选 -->
        <Border Grid.Row="0" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="路径与筛选" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                               Text="原图目录用于对比预览，卡图目录是 mod 的 images 目录；导入时按「卡池/卡牌文件.png」落盘。" />
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="88" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}" Text="原图目录" />
                    <TextBox Grid.Column="1" Text="{Binding OriginalRoot, UpdateSourceTrigger=PropertyChanged}"
                             LostFocus="PathBox_OnLostFocus" />
                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="浏览..." Click="BrowseOriginalRoot_OnClick" />
                </Grid>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="88" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}" Text="卡图目录" />
                    <TextBox Grid.Column="1" Text="{Binding OursRoot, UpdateSourceTrigger=PropertyChanged}"
                             LostFocus="PathBox_OnLostFocus" />
                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="浏览..." Click="BrowseOursRoot_OnClick" />
                </Grid>

                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="88" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}" Text="cards.json" />
                    <TextBox Grid.Column="1" Text="{Binding CardsJson, UpdateSourceTrigger=PropertyChanged}"
                             LostFocus="PathBox_OnLostFocus" />
                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="浏览..." Click="BrowseCardsJson_OnClick" />
                </Grid>

                <WrapPanel Grid.Row="8">
                    <TextBlock Style="{StaticResource RowLabel}" Text="卡池" Margin="0,0,8,0" />
                    <ComboBox Width="150" Margin="0,0,18,0"
                              ItemsSource="{Binding Nodes}"
                              SelectedItem="{Binding SelectedPool}" />
                    <TextBlock Style="{StaticResource RowLabel}" Text="状态" Margin="0,0,8,0" />
                    <ComboBox Width="110" Margin="0,0,18,0"
                              ItemsSource="{Binding StateFilters}"
                              SelectedIndex="{Binding StateFilter}" />
                    <TextBlock Style="{StaticResource RowLabel}" Text="搜索" Margin="0,0,8,0" />
                    <TextBox Width="230" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                </WrapPanel>
            </Grid>
        </Border>

        <!-- 主区 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="3.2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="3.2*" />
            </Grid.ColumnDefinitions>

            <!-- 卡牌列表 -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="卡牌" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                   Text="✔ 已替换　— 未替换；双击可在资源管理器中定位替换图。" />
                    </StackPanel>
                    <ListView Grid.Row="2"
                              ItemsSource="{Binding CardsView}"
                              SelectedItem="{Binding SelectedCard}"
                              MouseDoubleClick="CardList_OnMouseDoubleClick"
                              BorderThickness="0"
                              Background="Transparent"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="状态" Width="52" DisplayMemberBinding="{Binding Status}" />
                                <GridViewColumn Header="卡池" Width="96" DisplayMemberBinding="{Binding PoolDisplay}" />
                                <GridViewColumn Header="中文名" Width="180" DisplayMemberBinding="{Binding ChineseName}" />
                                <GridViewColumn Header="卡牌文件" Width="240" DisplayMemberBinding="{Binding FileName}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>

            <!-- 预览 -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource SectionTitle}" Text="预览" />

                    <Border Grid.Row="2" Style="{StaticResource PreviewTile}" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="原版卡图" />
                            <Image Grid.Row="1" Margin="0,4,0,4" Stretch="Uniform"
                                   Source="{Binding OriginalPreview}" />
                            <TextBlock Grid.Row="2" Style="{StaticResource Caption}" Text="{Binding OriginalInfo}" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="4" Style="{StaticResource PreviewTile}" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="替换卡图" />
                            <Image Grid.Row="1" Margin="0,4,0,4" Stretch="Uniform"
                                   Source="{Binding OursPreview}" />
                            <TextBlock Grid.Row="2" Style="{StaticResource Caption}" Text="{Binding OursInfo}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 待处理与操作 -->
            <Border Grid.Column="4" Style="{StaticResource Card}" AllowDrop="True"
                    DragEnter="DropZone_OnDragEnter" DragOver="DropZone_OnDragEnter" Drop="DropZone_OnDrop">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="待处理图片" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                   Text="拖入图片会自动按中文名/大小写/下划线/驼峰匹配卡牌；点击列表项即在预览区显示对应卡牌，红字为未匹配。「导入」单张，「完成导入」批量处理已匹配项。" />
                    </StackPanel>

                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding Pending}"
                             SelectedItem="{Binding SelectedPending}"
                             BorderThickness="0"
                             Background="#FFF9F7F2"
                             FontSize="12"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,3">
                                    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding FilePath}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMatched}" Value="False">
                                                        <Setter Property="Foreground" Value="#FFB91C1C" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding MatchText}" FontSize="11" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMatched}" Value="False">
                                                        <Setter Property="Foreground" Value="#FFB91C1C" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <WrapPanel Grid.Row="4">
                        <Button Content="添加图片" Click="AddImages_OnClick" />
                        <Button Style="{StaticResource GhostButton}" Content="还原" Click="Restore_OnClick" />
                        <Button Content="导入" Click="Import_OnClick" />
                        <Button Content="完成导入" Click="ImportAll_OnClick" />
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 状态 + 导出 -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="状态" />
                    <TextBlock Margin="0,6,0,0" FontSize="13" Text="{Binding SummaryMessage}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" Text="{Binding StatusMessage}" />
                </StackPanel>
                <Button Grid.Column="1" Margin="18,0,0,0" MinWidth="200" MinHeight="64"
                        FontSize="18" Content="导出 pck" Click="Export_OnClick"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}" />
            </Grid>
        </Border>
    </Grid>
</Window>
